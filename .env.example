# Copy to .env (git-ignored) and adjust. docker compose reads it automatically.
APP_VERSION=1.0.0-local
LOG_LEVEL=INFO
ENVIRONMENT=local
CHAOS_ENABLED=true

# Grafana admin credentials (required by docker-compose.monitoring.yml - no defaults on purpose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# Optional: Alertmanager -> Slack/Discord (bonus). Leave empty to disable.
SLACK_WEBHOOK_URL=
